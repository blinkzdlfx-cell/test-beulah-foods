{
  "name": "beulah-foods",
  "private": true,
  "version": "1.0.0",
  "description": "Testing and static validation tooling for Beulah Foods.",
  "type": "module",
  "scripts": {
    "lint": "eslint storefront admin worker.js",
    "format:check": "prettier --check \"storefront/**/*.js\" \"admin/**/*.js\" \"worker.js\"",
    "format": "prettier --write \"storefront/**/*.js\" \"admin/**/*.js\" \"worker.js\"",
    "static:check": "npm run lint",
    "test": "node --test tests"
  },
  "devDependencies": {
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "prettier": "3.9.6"
  }
}
